@@ -2208,7 +2208,11 @@ static int exec_one_fetched_inner(CPUState *cpu, uint32_t pc, uint32_t insn,
     case 0x0D: { /* ORI */
         uint32_t a = cpu->gpr[rs];
         if (rs == 0 && rt != 0 && psx_ws_is_signed_x_bound_site(pc, insn))
-            cpu->gpr[rt] = (uint32_t)psx_ws_screen_x_bound((int32_t)imm);
+            /* Bit 15 set: a negative bound kept as a 16-bit half for an
+             * unsigned SX compare (matches the native emit). */
+            cpu->gpr[rt] = (imm & 0x8000u)
+                ? ((uint32_t)psx_ws_screen_x_bound((int32_t)(int16_t)imm) & 0xFFFFu)
+                : (uint32_t)psx_ws_screen_x_bound((int32_t)imm);
         else
             cpu->gpr[rt] = a | imm;
         psx_pgxp_alu(cpu, insn, cpu->gpr[rt], a, imm);
